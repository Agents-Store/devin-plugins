# stack-ads: keys of the ads workspace. `init` copies this file to ads/.env.
# Fill in only the services you use; an empty value means "not configured".
# Where each key comes from: python3 ads/tools/ads.py doctor
# Never commit ads/.env. The workspace's own .gitignore already excludes it.

# ── Research ─────────────────────────────────────────────────────────────
# Firecrawl: reads your site and competitor pages, extracts the brand kit
FIRECRAWL_API_KEY=
# Apify: public ad libraries, social content, reviews
APIFY_TOKEN=
# DataForSEO: keyword volumes, CPC, competitors' paid keywords.
# These are the API login and the API password from the API Access page,
# not the password of the DataForSEO account.
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# ── Creative generation ──────────────────────────────────────────────────
# OpenAI: images, voice-over, analysis of creatives
OPENAI_API_KEY=
# Gemini: images, video, voice-over, music, analysis of images and video
GEMINI_API_KEY=
# fal.ai: catalogue of image, video, avatar and audio models
FAL_KEY=

# ── Google Ads and Search Console (one OAuth client serves both) ─────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Written by: python3 ads/tools/ads.py google login
GOOGLE_ADS_REFRESH_TOKEN=
# The account to advertise from: 10 digits, no dashes
GOOGLE_ADS_CUSTOMER_ID=
# Only when that account is reached through a manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Search Console property: sc-domain:example.com or https://www.example.com/
GSC_SITE_URL=
# Only for the google-ads MCP server (reads and asset uploads)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Meta: Facebook and Instagram ─────────────────────────────────────────
# System-user token with ads_management, ads_read, pages_show_list,
# pages_read_engagement, pages_manage_ads, business_management.
# For the meta-ads MCP server add ads_mcp_management and use an Employee-role
# system user: the server refuses the token of an Admin system user.
META_ACCESS_TOKEN=
# Digits only, without the act_ prefix
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_APP_ID=
META_APP_SECRET=
# Optional: conversion campaigns and Instagram placements
META_PIXEL_ID=
META_INSTAGRAM_USER_ID=

# ── TikTok ───────────────────────────────────────────────────────────────
# The TikTok MCP server signs in through OAuth and needs none of these.
# They are for the toolkit's direct API calls.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Optional: conversion campaigns
TIKTOK_PIXEL_ID=
